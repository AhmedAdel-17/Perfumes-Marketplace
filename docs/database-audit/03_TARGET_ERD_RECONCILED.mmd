    checkout_requests {
        uuid id PK
        text scope_key
        text request_key
        text payload_hash
        text state
        uuid order_id FK
        timestamptz expires_at
    }
    seller_operating_terms {
        uuid id PK
        uuid seller_id FK
        integer version
        timestamptz effective_from
        integer reserve_days
        integer dispute_days
        text cash_owner
        text settlement_direction
    }
    attribution_decisions {
        uuid id PK
        uuid sub_order_id FK
        text source
        integer policy_version
        integer commission_rule_set_version
        jsonb window_snapshot
        text reason
    }
    inventory_balances {
        uuid id PK
        uuid seller_id FK
        uuid product_id FK
        uuid location_id FK
        integer on_hand
        integer reserved
        integer safety_stock
        bigint version
    }
    inventory_reservations {
        uuid id PK
        uuid balance_id FK
        uuid order_line_id FK
        integer quantity
        text state
        text operation_key UK
        timestamptz expires_at
    }
    inventory_movements {
        uuid id PK
        uuid balance_id FK
        uuid reservation_id FK
        text operation_key UK
        integer on_hand_delta
        integer reserved_delta
        timestamptz occurred_at
        timestamptz recorded_at
    }
    ledger_transactions {
        uuid id PK
        text event_key UK
        uuid sub_order_id FK
        uuid reverses_transaction_id FK
        text currency
        timestamptz effective_at
        timestamptz posted_at
    }
    ledger_postings {
        uuid id PK
        uuid transaction_id FK
        uuid account_id FK
        uuid seller_id FK
        uuid order_line_id FK
        bigint amount_piastres
    }
    settlement_entries {
        uuid id PK
        uuid seller_id FK
        uuid ledger_transaction_id FK
        text claim_key UK
        text direction
        bigint amount_piastres
    }
    payout_allocations {
        uuid id PK
        uuid payout_line_id FK
        uuid settlement_entry_id FK
        bigint amount_piastres
    }
    refunds {
        uuid id PK
        uuid return_id FK
        uuid order_id FK
        text operation_key UK
        text provider_reference
        text state
        bigint amount_piastres
    }
    cod_remittances {
        uuid id PK
        uuid sub_order_id FK
        text event_key UK
        text cash_owner
        bigint expected_piastres
        bigint received_piastres
        bigint fee_piastres
        text reconciliation_state
    }
    outbox_events {
        uuid id PK
        text event_key UK
        text kind
        uuid aggregate_id
        jsonb minimal_payload
        timestamptz occurred_at
    }
