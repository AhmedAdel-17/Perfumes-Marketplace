    %% Code-defined data review candidate, 18 October 2026; migrations 0000..0035.
    %% 40 application tables plus schema_migrations infrastructure (SHA-256 ledger).
    %% All application columns; Drizzle plus SQL-only constraints.
    %% Composite FK products(brand_id,seller_id) -> brands(id,seller_id).
    %% Composite FK returns(line_item_id,sub_order_id) -> order_line_items(id,sub_order_id).
    %% Composite FK reviews(line_item_id,sub_order_id,product_id) -> order_line_items(id,sub_order_id,product_id).
    %% 0035 invoker triggers enforce order/payout line seller identity and immutable parent seller_id.
